# AI Provider Configuration
# Copy this file to .env and add your actual API keys

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Stability AI Configuration  
# Get your API key from: https://platform.stability.ai/account/keys
# STABILITY_API_KEY=sk-your-stability-api-key-here

# Replicate Configuration
# Get your API token from: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=r8_your-replicate-token-here

# HuggingFace Configuration
# Get your API key from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=hf_your-huggingface-token-here

# Provider Priority Configuration
# Set which provider to use by default (if multiple are configured)
# Options: openai, stability, replicate, huggingface, free-test-provider
DEFAULT_AI_PROVIDER=free-test-provider

# Cost Limits (optional)
# Set maximum cost per image generation request in USD
# MAX_COST_PER_REQUEST=1.00

# Rate Limiting (optional)  
# Maximum requests per minute per provider
# MAX_REQUESTS_PER_MINUTE=10
